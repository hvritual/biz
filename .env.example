YUNKA_BIZ_MYSQL_DSN=root:YOUR_LOCAL_PASSWORD@tcp(127.0.0.1:13316)/biz_evolution?parseTime=true&charset=utf8mb4&loc=UTC
YUNKA_BIZ_AUTO_MIGRATE=true
YUNKA_BIZ_BOOTSTRAP_TOKEN=change-me
YUNKA_BIZ_HTTP_LISTEN=127.0.0.1:8080
YUNKA_BIZ_GRPC_LISTEN=127.0.0.1:9090

# Reuse the existing local instance; actual settings live in ignored .env.local.
EVOLUTION_MYSQL_CONTAINER=biz-evolution-mysql-20260912

# #176 member onboarding stays disabled until an operator explicitly configures
# an activation TTL and the #170 verification keyring.
# YUNKA_BIZ_MEMBER_ACTIVATION_TTL=15m
# YUNKA_BIZ_VERIFICATION_ACTIVE_KEY_VERSION=v1
# YUNKA_BIZ_VERIFICATION_KEYS_JSON={"v1":"<base64-aes-key>"}
# YUNKA_BIZ_VERIFICATION_HMAC_KEY_B64=<base64-hmac-key>

# Enable only when the configured OIDC issuer is CoffeeLink's first-party IdP.
# This lets phone-only Accounts bind the signed "biz-user:<id>" subject without
# inventing an email address.
# YUNKA_BIZ_OIDC_TRUST_BIZ_USER_SUBJECT=true
