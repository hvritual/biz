# Optional. Leave empty in local development to use the Vite /v1 proxy to 127.0.0.1:8080.
VITE_BIZ_API_BASE=

# Tenantless platform principal used only by Platform Console /v1/tenants operations.
VITE_BIZ_PLATFORM_TOKEN=

# Tenant-bound token used only by Tenant Workspace operations.
VITE_BIZ_TENANT_TOKEN=
