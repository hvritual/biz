{
  "name": "coffeelink-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "type-check": "vue-tsc -b",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run type-check && npm run lint && npm run check:architecture && npm run test:unit && npm run build"
  },
  "dependencies": {
    "vue": "3.5.42",
    "vue-router": "^4.5.1",
    "pinia": "^3.0.3",
    "lucide-vue-next": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.8.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vue-tsc": "^3.0.0",
    "vitest": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.34.0",
    "eslint-plugin-vue": "^10.4.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "prettier": "^3.6.2"
  }
}
