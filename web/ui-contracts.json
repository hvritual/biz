  "rules": {
    "platform_surface_forbids_runtime_console": true,
    "navigation_overlay_must_not_push_content": true,
    "screenshots_are_acceptance_evidence": true,
    "navigation_section_groups_required": true,
    "navigation_forbids_entity_bound_paths": true,
    "navigation_drink_configuration_domain": "device-operations",
    "navigation_rental_work_collections_required": true,
    "enterprise_canonical_routes_required": true,
    "product_shell_forbids_data_mode_ui_branch": true,
    "product_surface_forbids_engineering_language": true,
    "product_surface_requires_backend_term_i18n_projection": true,
    "unknown_backend_terms_must_not_fallback_to_raw": true,
    "backend_error_messages_must_use_business_fallback": true,
    "e2e_forbids_engineering_copy_assertions": true
  },
