        "src/services/enterprise/memberRuntime.ts",
        "src/services/enterprise/roleRuntime.ts",
        "src/services/enterprise/departmentRuntime.ts",
        "src/features/platform/components/EntitlementOverrideDialog.vue",
        "src/features/platform/components/EntitlementOverrideTable.vue",
        "src/features/platform/components/EntitlementDecisionTable.vue",
        "src/features/platform/components/SubscriptionChangeWorkspace.vue",
        "src/features/enterprise/components/PlanChangeLifecycle.vue",
        "src/features/platform/pages/CommercialTenantEntitlementsView.vue",
        "src/features/platform/pages/CommercialModulesView.vue",
        "src/services/enterprise/rolePermissionCatalog.ts",
        "src/features/enterprise/components/members/MemberDetailDrawer.vue"
      ]
    },
    "backend_error_projection": {
