  "patterns": {
    "ListPage": {
      "status": "implemented",
      "use_when": "浏览同一对象集合并筛选、查看或批量选择；查询与选择必须有独立状态。",
      "avoid_when": "多阶段配置、复杂对象关系或流程处置不应强迫放入表格加抽屉。",
      "required_regions": [
        "page-heading",
        "query",
        "data"
      ],
      "optional_regions": [
        "metrics",
        "toolbar",
        "pagination",
        "detail"
      ],
      "states": [
        "loading",
        "empty",
        "no-results",
        "error",
        "unsupported",
        "feature-locked",
        "no-permission"
      ],
      "examples": [
        "/platform/tenants",
        "/enterprise/members",
        "/enterprise/roles",
        "/enterprise/logs"
      ]
    },
    "WorkbenchPage": {
      "status": "implemented",
      "use_when": "需要多个相关区域协作、对象上下文或配置影响比较；每页补充其实际工作区合同。",
      "avoid_when": "简单对象列表或单一资料表单不需要包装成万能工作台。",
      "required_regions": [
        "page-heading"
      ],
      "optional_regions": [
        "authority",
        "context",
        "metrics",
        "workspace",
        "history",
        "detail"
      ],
      "states": [
        "loading",
        "empty",
        "error",
        "unsupported",
        "feature-locked",
        "no-permission"
      ],
      "examples": [
        "/platform/overview",
        "/enterprise/organization",
        "/enterprise/plan"
      ]
    },
    "FormPage": {
      "status": "implemented",
      "use_when": "编辑有明确作用域的配置；分组、校验、未保存草稿、取消与服务端读回分别表达。",
      "avoid_when": "批量对象处理、授权诊断与远程任务不能因存在输入控件就视作普通表单。",
      "required_regions": [
        "page-heading",
        "form-workspace",
        "scope"
      ],
      "optional_regions": [
        "form-actions",
        "history"
      ],
      "states": [
        "loading",
        "error",
        "unsupported",
        "feature-locked",
        "no-permission",
        "dirty",
        "submitting",
        "conflict",
        "readback-failed"
      ],
      "examples": [
        "/enterprise/company",
        "/system/:section(general|notifications|security|integrations|dictionary)"
      ]
    },
    "MetricsPage": {
      "status": "reserved",
      "use_when": "有已接入的经营指标来源，并明确范围、时间窗口、单位、统计口径与新鲜度。",
      "avoid_when": "不能用零值填充未知数据；没有真实指标消费者时不预建页面。",
      "required_regions": [
        "page-heading",
        "scope",
        "time-range",
        "metrics",
        "methodology"
      ],
      "optional_regions": [
        "drilldown"
      ],
      "states": [
        "loading",
        "empty",
        "error",
        "stale",
        "unknown",
        "no-permission"
      ],
      "examples": []
    }
  },
  "presentation": {
    "backend_term_projection": {
      "catalog": "@/i18n/backend-terms.ts",
      "messages": "@/i18n/backend-term-messages.ts",
      "unknown_value_policy": "business_fallback",
      "required_consumers": [
