{
  "schema_version": 1,
  "design_system": "CoffeeLink V1.2",
  "visual_viewports": [
    { "width": 1366, "height": 768 },
    { "width": 1440, "height": 900 },
    { "width": 1536, "height": 1024 },
    { "width": 390, "height": 844 }
  ],
  "rules": {
    "platform_surface_forbids_runtime_console": true,
    "navigation_overlay_must_not_push_content": true,
    "screenshots_are_acceptance_evidence": true,
    "navigation_section_groups_required": true,
    "navigation_forbids_entity_bound_paths": true,
    "navigation_drink_configuration_domain": "device-operations",
    "navigation_rental_work_collections_required": true,
    "enterprise_canonical_routes_required": true,
    "product_shell_forbids_data_mode_ui_branch": true
  },
  "navigation": {
    "primary_domains": ["工作台", "客户经营", "租赁运营", "设备运营", "经营管理", "企业中心", "平台管理", "系统设置"],
    "required_section_groups": ["客户管理", "客户协同", "客户成功", "投放与资产", "计费与结算", "履约与服务", "设备资产", "设备配置", "远程运维", "服务维护", "交易管理", "经营分析"],
    "forbidden_entity_path_tokens": ["CUS-", "CS-", "SH-"],
    "rental_work_collections": [
      { "label": "投放交付", "path": "/rental/delivery", "kind": "delivery", "id": "delivery" },
      { "label": "服务恢复验证", "path": "/rental/service", "kind": "service", "id": "service" },
      { "label": "回款跟进", "path": "/rental/payment", "kind": "payment", "id": "payment" },
      { "label": "退租回收", "path": "/rental/returns", "kind": "return", "id": "return" }
    ],
    "primary_domain_ids": ["dashboard", "customer-operations", "rental-operations", "device-operations", "business-operations", "enterprise", "platform-commercial", "system"],
    "section_groups": {
      "customer-management": "客户管理",
      "customer-collaboration": "客户协同",
      "customer-success": "客户成功",
      "deployment-assets": "投放与资产",
      "billing-settlement": "计费与结算",
      "fulfillment-service": "履约与服务",
      "device-assets": "设备资产",
      "device-configuration": "设备配置",
      "remote-operations": "远程运维",
      "service-maintenance": "服务维护",
      "transaction-management": "交易管理",
      "business-analytics": "经营分析"
    }
  },
  "routes": [
    {
      "path": "/platform/overview",
      "component": "@/features/platform/pages/PlatformOverviewView.vue",
      "surface": "platform",
      "template": "WorkbenchPage",
      "required_regions": ["page-heading", "management-domains", "governance"]
    },
    {
      "path": "/platform/tenants",
      "component": "@/features/platform/pages/PlatformTenantsView.vue",
      "surface": "platform",
      "template": "ListPage",
      "required_regions": ["page-heading", "metrics", "query", "data", "pagination"]
    },
    {
      "path": "/system/:section(general|notifications|security|integrations|dictionary)",
      "component": "@/features/system/pages/SettingsView.vue",
      "surface": "tenant",
      "template": "FormPage",
      "required_regions": []
    },
    {
      "path": "/platform/commercial/modules",
